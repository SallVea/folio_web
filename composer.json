{
    "name": "sall/folio",
    "type": "project",
    "description": "Folio - Personal Portfolio Showcase",
    "keywords": ["laravel", "folio", "portfolio"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "abandoned": "ignore",
            "auditor": "ignore"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "policy": {
        "advisories": {
            "block": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
