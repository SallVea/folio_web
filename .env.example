APP_NAME=Folio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database PostgreSQL (Docker) ───
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=folio_db
DB_USERNAME=folio_user
DB_PASSWORD=folio_pass

# ─── Session & Cache ───
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ─── Storage (public agar foto bisa diakses via URL) ───
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@folio.app"
MAIL_FROM_NAME="${APP_NAME}"
